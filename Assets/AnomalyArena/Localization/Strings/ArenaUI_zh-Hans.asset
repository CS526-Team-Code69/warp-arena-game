  - m_Id: 818548779
    m_Localized: "\u9AD8\u9636\u865A\u7A7A\u5956\u52B1"
    m_Metadata:
      m_Items: []
  - m_Id: 818548780
    m_Localized: "\u4ECE\u4E09\u4E2A\u9AD8\u9636\u865A\u7A7A\u6280\u80FD\u91CC\u9009\u4E00\u4E2A\uFF08\u53EF\u4EE5\u4E0D\u9009\uFF09\uFF0C\u6CA1\u6709\u540E\u7EED\u5347\u7EA7\u3002\u6309 1 / 2 / 3 \u9009\u62E9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548781
    m_Localized: "\u7B2C {0} / {1} \u7EC4\u9009\u5361"
    m_Metadata:
      m_Items: []
  - m_Id: 818548782
    m_Localized: Survive the warp. Master every anomaly.
    m_Metadata:
      m_Items: []
  - m_Id: 818548783
    m_Localized: "\u9009\u62E9\u4E00\u79CD\u719F\u6089\u7684\u5916\u5F62\u3002\u62FF\u5230\u4E4B\u524D\u4E0D\u77E5\u9053\u662F\u54EA\u79CD\u53CD\u566C\uFF1B\u9009\u4E2D\u7684\u90A3\u4E00\u523B\u63ED\u6653\uFF1A\u6E38\u620F\u6682\u505C\uFF0C\u5F39\u51FA\u6B66\u5668\u5361\u3002\n\u624B\u52A8\u7784\u51C6\uFF0C\u5229\u7528\u5730\u5F62\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548784
    m_Localized: "\u4E09\u9009\u4E00\uFF1A\u4E00\u4EF6\u65B0\u6B66\u5668\uFF0C\u6216\u5DF2\u6301\u6709\u6B66\u5668\u7684\u66F4\u9AD8\u578B\u53F7\uFF08\u6B66\u5668\u53D8\u5F3A\u9760\u519B\u68B0\u5E93\u91CC\u7684\u66F4\u9AD8\u578B\u53F7\uFF09\u3002\u4E5F\u53EF\u4EE5\u8DF3\u8FC7\u3002\u5F3A\u5316\u8DDF\u7740\u6B66\u5668\u8D70\uFF0C\u6B66\u5668\u88AB\u66FF\u6362\u6389\uFF0C\u5B83\u8EAB\u4E0A\u7684\u5F3A\u5316\u4E5F\u4E00\u8D77\u6CA1\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548785
    m_Localized: "\u4E09\u5F20\u5361\u6BCF\u79CD\u4E00\u5F20\uFF1A\u5C5E\u6027\u5361\u3001\u6B66\u5668\u5361\uFF08\u7ED9\u4E00\u628A\u5DF2\u7ECF\u63ED\u6653\u7684\u6B66\u5668\u4E00\u4E2A\u8FD8\u6CA1\u62FF\u8FC7\u7684\u5F3A\u5316\u65B9\u5411\uFF09\u3001\u6280\u80FD\u5361\uFF08\u4E00\u4E2A\u65B0\u6280\u80FD\uFF0C\u6216\u8005\u7ED9\u5DF2\u6709\u6280\u80FD\u5347\u4E00\u7EA7\uFF09\u3002\u6309 1 / 2 / 3 \u9009\u62E9\uFF1BR \u91CD\u62BD\uFF08\u6BCF\u6B21\u6574\u5907\u4E00\u6B21\uFF09\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548786
    m_Localized: "\u9009\u62E9\u8981\u66FF\u6362\u7684\u6B66\u5668\u3002\u5F3A\u5316\u8DDF\u7740\u6B66\u5668\u8D70\uFF0C\u6B66\u5668\u88AB\u66FF\u6362\u6389\uFF0C\u5B83\u8EAB\u4E0A\u7684\u5F3A\u5316\u4E5F\u4E00\u8D77\u6CA1\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548787
    m_Localized: "\u5DF2\u6709 3 \u4E2A\u6280\u80FD\u65F6\u518D\u9009\u62E9\u65B0\u6280\u80FD\uFF0C\u5C31\u8981\u9009\u4E00\u4E2A\u65E7\u7684\u66FF\u6362\uFF0C\u65B0\u6280\u80FD\u4ECE 1 \u7EA7\u5F00\u59CB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548788
    m_Localized: "\u6574\u5907\u9009\u9879\u5DF2\u5B8C\u6210\u3002\u70B9\u51FB\u300C\u5F00\u59CB\u4E0B\u4E00\u6CE2\u300D\u7EE7\u7EED\u3002"
