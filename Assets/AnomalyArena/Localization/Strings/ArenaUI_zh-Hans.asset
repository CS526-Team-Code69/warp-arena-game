      m_Items: []
  - m_Id: 818548945
    m_Localized: "\u4E2D\u6587\uFF08\u56E2\u961F\uFF09"
    m_Metadata:
      m_Items: []
  - m_Id: 818548946
    m_Localized: "\u82F1\u6587\uFF08\u5C55\u793A\uFF09"
    m_Metadata:
      m_Items: []
  - m_Id: 818548947
    m_Localized: "\u9AD8\u9636\u865A\u7A7A\u5956\u52B1"
    m_Metadata:
      m_Items: []
  - m_Id: 818548948
    m_Localized: "\u7B2C {0} / {1} \u7EC4\u9009\u5361"
    m_Metadata:
      m_Items: []
  - m_Id: 818548949
    m_Localized: "\u91CD\u62BD [{0}]"
    m_Metadata:
      m_Items: []
  - m_Id: 818548950
    m_Localized: "\u6EE1\u84C4\u529B\u5B50\u5F39\u6700\u591A\u5F39\u5899 2 \u6B21\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548951
    m_Localized: "\u84C4\u529B\u65F6\u4E0D\u518D\u51CF\u901F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548952
    m_Localized: "\u53CD\u5411\u5B50\u5F39\u7684\u5F39\u5899\u6B21\u6570\u4ECE 1 \u6B21\u589E\u52A0\u5230 3 \u6B21\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548953
    m_Localized: "\u53CD\u5411\u5B50\u5F39\u98DE\u51FA 0.3 \u79D2\u540E\u6389\u5934\u671D\u4F60\u7684\u7784\u51C6\u65B9\u5411\u98DE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548954
    m_Localized: "\u98DE\u5200\u6700\u591A\u5F39\u5899 2 \u6B21\u540E\u7EE7\u7EED\u98DE\u884C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548955
    m_Localized: "\u51FB\u6740\u540E\u76F4\u7EBF\u8FD4\u56DE\u7684\u98DE\u5200\u4E0D\u518D\u4F24\u5230\u4F60\uFF0C\u4ECD\u4F1A\u4F24\u5BB3\u8DEF\u4E0A\u7684\u654C\u4EBA\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548956
    m_Localized: "\u94A9\u5B50\u547D\u4E2D\u5899\u9762\u65F6\uFF0C\u628A\u4F60\u79FB\u52A8\u5230\u5899\u524D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548957
    m_Localized: "\u88AB\u629B\u51FA\u7684\u654C\u4EBA\u843D\u5730\u540E\u7729\u6655 1.5 \u79D2\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548958
    m_Localized: "\u7206\u70B8\u628A\u8303\u56F4\u5185\u89D2\u8272\u62C9\u5411\u4E2D\u5FC3\uFF0C\u53D6\u4EE3\u5411\u5916\u51FB\u9000\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548959
    m_Localized: "\u81EA\u5DF1\u7684\u7206\u70B8\u4E0D\u6263\u4F60\u7684\u751F\u547D\uFF0C\u4F46\u4ECD\u4F1A\u4F7F\u4F60\u4F4D\u79FB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548960
    m_Localized: "\u98DE\u884C\u5728\u7A7A\u5730\u7ED3\u675F\u65F6\uFF0C\u628A\u534A\u5F84 3 \u5185\u654C\u4EBA\u5411\u5916\u63A8 8 \u5355\u4F4D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548961
    m_Localized: "\u649E\u5899\u4E0D\u518D\u6263\u4F60\u7684\u751F\u547D\uFF0C\u4ECD\u4F1A\u5411\u540E\u5F39 3 \u5355\u4F4D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548962
    m_Localized: "\u7275\u5F15\u7ED3\u675F\u5411\u5916\u51FB\u90003\u5355\u4F4D\uFF0C\u4E0D\u52A0\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548963
    m_Localized: "\u81EA\u5DF1\u7684\u7275\u5F15\u573A\u4E0D\u518D\u62C9\u81EA\u5DF1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548964
    m_Localized: "\u6392\u65A5\u53EA\u5F71\u54CD\u51C6\u661F\u524D\u65B9180\xB0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548965
    m_Localized: "\u53D6\u6D88\u81EA\u8EAB2\u5355\u4F4D\u540E\u5750\uFF0C\u7ECF\u9A8C\u7403\u4ECD\u4F1A\u88AB\u63A8\u6563\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548966
    m_Localized: "\u628A\u4E24\u4FA7\u654C\u4EBA\u8D76\u5411\u7784\u51C6\u7EBF\uFF0C\u7EBF\u4E0A\u76EE\u6807\u5411\u524D\u63A8\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548967
    m_Localized: "\u6362\u5F39\u4E0D\u518D\u5361\u58F3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548968
    m_Localized: "\u96C6\u4E2D\u5F39\u4E38\u7A7F\u900F\u7B2C\u4E00\u4E2A\u76EE\u6807\uFF0C\u4E4B\u540E\u7684\u76EE\u6807\u53D7 60% \u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548969
    m_Localized: "\u677E\u624B\u7684\u540E\u5750\u6539\u4E3A\u4E0D\u4F1A\u649E\u5899\u53D7\u4F24\u7684\u63A8\u79FB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548970
    m_Localized: "\u5315\u9996\u7A7F\u8FC7\u7B2C\u4E00\u4EBA\uFF0C\u4E0E\u7B2C\u4E8C\u4E2A\u5408\u6CD5\u76EE\u6807\u4EA4\u6362\uFF1B\u6BCF\u4EBA\u4EC5\u4E00\u6B21\u547D\u4E2D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548971
    m_Localized: "\u6210\u529F\u4EA4\u6362\u540E\u83B7\u5F970.5\u79D2\u53D7\u51FB\u4FDD\u62A4\uFF0C\u4E0D\u6E05\u72B6\u6001\u3001\u4E0D\u9632\u6389\u6D1E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548972
    m_Localized: "\u79BB\u5F00\u5904\u4E5F\u7206\u70B8\uFF1B\u4E24\u5708\u91CD\u53E0\u7684\u540C\u4E00\u654C\u4EBA\u53EA\u53D7\u4E00\u6B21\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 818548973
