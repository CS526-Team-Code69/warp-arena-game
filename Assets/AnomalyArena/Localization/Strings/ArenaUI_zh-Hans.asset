    m_Localized: "\u865A\u7A7A"
    m_Metadata:
      m_Items: []
  - m_Id: 818548935
    m_Localized: EVERY WEAPON HAS A TWIST.
    m_Metadata:
      m_Items: []
  - m_Id: 818548936
    m_Localized: "WASD \u79FB\u52A8 \xB7 \u9F20\u6807 \u7784\u51C6 \xB7 \u5DE6\u952E \u4F7F\u7528\u624B\u6301\u6B66\u5668 \xB7 \u53F3\u952E \u5207\u6362\u624B\u6301\u680F\u4F4D \xB7 Shift \u51B2\u523A \xB7 1/2/3 \u91CA\u653E\u6280\u80FD \xB7 Esc \u6682\u505C"
    m_Metadata:
      m_Items: []
  - m_Id: 818548937
    m_Localized: "\u624B\u63011 [\u5DE6\u952E]"
    m_Metadata:
      m_Items: []
  - m_Id: 818548938
    m_Localized: "\u624B\u63012 [\u53F3\u952E\u5207\u6362]"
    m_Metadata:
      m_Items: []
  - m_Id: 818548939
    m_Localized: "\u81EA\u52A81"
    m_Metadata:
      m_Items: []
  - m_Id: 818548940
    m_Localized: "\u81EA\u52A82"
    m_Metadata:
      m_Items: []
  - m_Id: 818548941
